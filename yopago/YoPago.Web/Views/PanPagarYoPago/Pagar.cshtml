@model PagoVM
@{
    ViewData["Title"] = "Pagar";
}
<h1>Pagar la compra @Model.NumeroCompra</h1>
@if (ViewBag.Error != null)
{
    <p class="error">@ViewBag.Error</p>
}
<form method="post" action="/pagar" class="tarjeta">
    @Html.AntiForgeryToken()
    <input type="hidden" name="NumeroCompra" value="@Model.NumeroCompra" />
    <input type="hidden" name="Valor" value="@Model.Valor" />
    <p class="valor">$ @Model.Valor.ToString("N2")</p>
    <button type="submit">Confirmar pago</button>
</form>
<p><a href="/compras">Volver a mis compras</a></p>

@model List<CompraPendienteVM>
@{
    ViewData["Title"] = "Compras pendientes";
}
<h1>Compras SSO pendientes por pago</h1>
@if (Model.Count == 0)
{
    <p>No tiene compras pendientes.</p>
}
else
{
    <table>
        <thead><tr><th>Número de compra</th><th>Valor con impuestos</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.NumeroCompra</td>
                <td>$ @c.Valor.ToString("N2")</td>
                <td><a class="boton" href="/pagar/@c.NumeroCompra">Pagar</a></td>
            </tr>
        }
        </tbody>
    </table>
}
